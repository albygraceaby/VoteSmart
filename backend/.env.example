# Server
PORT=5000
NODE_ENV=production

# MongoDB — use Atlas URI for production
# Get free cluster: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/votesmart?retryWrites=true&w=majority

# JWT Auth
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=7d

# Frontend URL (for CORS) — set to your deployed frontend URL
CLIENT_URL=https://your-app.onrender.com
